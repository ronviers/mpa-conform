# Per-machine settings
.claude/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.pytest_cache/
.mypy_cache/

# IDE
.vscode/
.idea/
*.swp

# Staging output — driver profiles + DataUploads land here before
# curator-signed PRs into mpa-auditor's seed-corpus/. v0.1 keeps them
# uncommitted (the repo's job is the pipeline + schema, not the data).
# A future session may decide to commit the seed-corpus alongside the
# pipeline; flip this then.
output/seed-corpus/

# Comparison figures (three-way empirical/predicted/Banach PNGs from
# `python -m conformer.cli compare`). Regenerated on demand.
output/comparisons/

# Shot artifacts (EXR sequences + mp4 previews from
# `python -m conformer.cli shot`). EXR files are large; both are
# regenerated on demand.
output/shots/

# Calibration sweep artifacts (parquets + PNGs from
# `python -m conformer.calibration`). Regenerable from the sweep
# harness; per-substrate baselines live separately at
# H:/mpa-central/library/baselines/.
output/calibration/

# Character-test shot artifacts.
output/tests/

# Local dev profiles
dev_profile.json

# Block-in pose workspace — transient blind copies (packet, sanitized data,
# sanitized traversal, the answerer's scratch). pose.py regenerates them every
# pose; the durable result is deposited under blockin/earned/<slug>/.
blockin/workspace/

# Blanket: exclude all pipeline output (renders/EXR/mp4 ~GB-scale; regenerable).
# Supersedes the per-subdir rules above; the repo backs up code+schema, not data.
output/
